# -*- coding: utf-8 -*-
# .env.example — Конфигурация окружения
#
# Скопируйте в .env и настройте под своё окружение.

# Ollama endpoint (без /api/... — путь добавляется адаптером)
OLLAMA_BASE_URL=http://192.168.5.7:11434

# Модели по умолчанию
ARCHITECT_MODEL=qwen3-coder:30b
CODER_MODEL=qwen2.5-coder:14b
META_MODEL=deepseek-r1:32b

# Таймаут тестов (секунды) и параллелизм
TEST_TIMEOUT=300
MAX_CONCURRENCY=2

# Трейсинг
TRACES_DIR=traces
MAX_SESSIONS=20

# MCP-сервер (опционально)
MCP_SERVER_URL=http://localhost:3000
