# -*- coding: utf-8 -*-
# .env.example — Конфигурация окружения для v1
#
# Скопируйте в .env и настройте под своё окружение.

# Ollama endpoint
OLLAMA_URL=http://192.168.5.7:11434/api/generate

# Модели по умолчанию
ANALYZER_MODEL=qwen2.5-coder:14b
ARCHITECT_MODEL=qwen3-coder:30b

# Трейсинг
TRACES_DIR=traces
MAX_SESSIONS=20

# MCP-сервер (опционально)
MCP_SERVER_URL=http://localhost:3000